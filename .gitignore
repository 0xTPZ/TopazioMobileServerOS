# Generated build output and local experiments
build/out/
build/artifacts/
build/vendor-cache/
*.log
*.tmp
*.swp

# Python and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/

# Secrets and personal material
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
credentials.json
token.json
secrets.*

